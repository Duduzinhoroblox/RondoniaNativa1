# ============================================================================
# RONDÔNIA NATIVA — VARIÁVEIS DE AMBIENTE (.env.example)
# Instruções: Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# NUNCA envie o arquivo .env com credenciais reais para o repositório Git!
# ============================================================================

# Porta do Servidor Web Local (Padrão Vite: 3000)
PORT=3000
VITE_APP_NAME="Rondonia Nativa"
VITE_APP_URL="http://localhost:3000"

# Banco de Dados Relacional (PostgreSQL / Supabase / Neon)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rondonia_nativa
DB_USER=postgres
DB_PASS=sua_senha_segura_aqui

# Conexão com Gateway de Pagamento e Social Split (Modo Sandbox / Fictício para Teste)
VITE_SPLIT_GATEWAY_URL="https://api.sandbox.asaas.com/v3"
VITE_SPLIT_GATEWAY_API_KEY="sk_test_rondonia_nativa_centelha3_split_mock_key"

# Chave Criptográfica para Assinatura de Vouchers Offline (SHA-256)
VITE_OFFLINE_SECRET_SALT="ro_nativa_offline_salt_centelha3_2026"

# Integração com APIs Públicas Ambientais (Homologação)
VITE_FUNAI_API_ENDPOINT="https://sistemas.funai.gov.br/api/homologacao"
VITE_ICMBIO_API_ENDPOINT="https://sistemas.icmbio.gov.br/api/homologacao"
